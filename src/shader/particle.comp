#version 450

struct Particle
{
  vec2 position;
  vec3 color;
  vec2 velocity;
};

layout(std430, binding = 0) buffer ParticleBuffer
{
  Particle particlesA[];
};

layout(std430, binding = 1) buffer TemporaryParticleBuffer
{
  Particle particlesB[];
};

layout(std430, binding = 2 ) buffer CellHeadBuffer
{
  int cellHeads[];
};

layout(std430, binding = 3) buffer NextParticleBuffer
{
  int nextParticles[];
};

layout(push_constant) uniform PushConstants
{
  uint pass;
  vec2 screenSize;
  float deltaTime;
};

layout(local_size_x = 256) in;

uint hash(uint x)
{
  x ^= x >> 16;
  x *= 0x7feb352du;
  x ^= x >> 15;
  x *= 0x846ca68bu;
  x ^= x >> 16;
  return x;
}

float randomFloat(uint x)
{
  return float(hash(x)) / 4294967295.0f;
}

float pixelsToNDC(int number, int reference)
{
  return number * (2.0f / reference);
}

int PARTICLE_RADIUS = 4;
float PARTICLE_BOUNCINESS = 0.15f;
float WORLD_HEIGHT = 10.0f;
float NDC_PER_METER = 2.0f / WORLD_HEIGHT;
vec2 GRAVITY = vec2(0.0f, 9.81 * NDC_PER_METER);

int GRID_HEIGHT = 50;
int GRID_WIDTH = 50;

ivec2 getCell(vec2 position)
{
  vec2 normPos = position * 0.5f + 0.5f;
  ivec2 cell = ivec2(floor(normPos * vec2(GRID_WIDTH, GRID_HEIGHT)));

  return clamp(cell, ivec2(0,0), ivec2(GRID_WIDTH - 1, GRID_HEIGHT - 1));
}
uint getCellID(ivec2 cell)
{
  return cell.y * GRID_WIDTH + cell.x;
}
void main()
{
  uint i = gl_GlobalInvocationID.x;
  
  if(pass == 0)
  {
    if(i >= particlesA.length())
      return;

    uint count = particlesA.length();
    float aspect = screenSize.x / screenSize.y;

    uint gridWidth = uint(ceil(sqrt(float(count) * aspect)));
    uint gridHeight = uint(ceil(float(count) / float(gridWidth)));
    uint x = i % gridWidth;
    uint y = i / gridWidth;

    particlesA[i].position = vec2(
      (float(x) + 0.5) / float(gridWidth) * 2.0 - 1.0,
      (float(y) + 0.5) / float(gridHeight) * 2.0 - 1.0
    );

    particlesA[i].color = vec3(
      randomFloat(i),
      randomFloat(i + 1),
      randomFloat(i + 2)
    );
   
    float seed = float(i);

    vec2 initialVelocity = vec2(sin(seed * 12.9898), cos(seed * 78.233));

    particlesA[i].velocity = initialVelocity * 0.15;

    return;
  }
  else if(pass == 1)
  {
    if(i >= cellHeads.length())
      return;

    cellHeads[i] = -1;
  }
  else if(pass == 2)
  {
    if(i >= particlesB.length())
      return;

    Particle tempParticle = particlesA[i];

    tempParticle.velocity += GRAVITY * deltaTime;
    tempParticle.position += tempParticle.velocity * deltaTime;

    if(tempParticle.position.x + pixelsToNDC(PARTICLE_RADIUS, int(screenSize.x))>= 1.0f && tempParticle.velocity.x > 0.0f)
      tempParticle.velocity.x *= -PARTICLE_BOUNCINESS;

    if(tempParticle.position.x - pixelsToNDC(PARTICLE_RADIUS, int(screenSize.x)) <= -1.0f && tempParticle.velocity.x < 0.0f)
      tempParticle.velocity.x *= -PARTICLE_BOUNCINESS;

    if(tempParticle.position.y + pixelsToNDC(PARTICLE_RADIUS, int(screenSize.y)) >= 1.0f && tempParticle.velocity.y > 0.0f)
      {tempParticle.velocity.y *= -PARTICLE_BOUNCINESS; tempParticle.velocity.x *= 0.5f;}

    if(tempParticle.position.y - pixelsToNDC(PARTICLE_RADIUS, int(screenSize.y)) <= -1.0f && tempParticle.velocity.y < 0.0f)
      tempParticle.velocity.y *= -PARTICLE_BOUNCINESS;

    tempParticle.position.x = clamp(tempParticle.position.x, -1.0f + pixelsToNDC(PARTICLE_RADIUS, int(screenSize.x)), 1.0f - pixelsToNDC(PARTICLE_RADIUS, int(screenSize.x)));
    tempParticle.position.y = clamp(tempParticle.position.y, -1.0f + pixelsToNDC(PARTICLE_RADIUS, int(screenSize.y)), 1.0f - pixelsToNDC(PARTICLE_RADIUS, int(screenSize.y)));

    particlesB[i] = tempParticle;

  }
  else if(pass == 3)
  {
    if(i >= particlesB.length())
      return;

    uint cellID = getCellID(getCell(particlesB[i].position));

    int oldHead = atomicExchange(cellHeads[cellID], int(i));
    nextParticles[i] = oldHead;
  }
  else if(pass == 4)
  {
    if(i >= particlesB.length())
      return;

    Particle p = particlesB[i];
    ivec2 cell = getCell(p.position);

    vec2 basePosition = p.position;
    vec2 baseVelocity = p.velocity;

    vec2 positionCorrectionPixels = vec2(0.0);
    vec2 velocityCorrectionPixels = vec2(0.0);

    vec2 pixelsPerNdc = screenSize * 0.5f;
    vec2 ndcPerPixel = vec2(2.0f) / screenSize;
    float diameter = float(PARTICLE_RADIUS) * 2.0;

    for(int offsetY = -1; offsetY <= 1; offsetY++)
    {
      for(int offsetX = -1; offsetX <= 1; offsetX++)
      {
        ivec2 neighbor = cell + ivec2(offsetX, offsetY);

        if(neighbor.x < 0 || neighbor.x >= GRID_WIDTH) continue;
        if(neighbor.y < 0 || neighbor.y >= GRID_HEIGHT) continue;

        int otherIndex = cellHeads[getCellID(neighbor)];

        while(otherIndex != -1)
        {
          if(uint(otherIndex) == i)
          {
            otherIndex = nextParticles[otherIndex];
            continue;
          }

          Particle other = particlesB[otherIndex];

          vec2 diffPixels = (basePosition - other.position) * pixelsPerNdc;
          float distanceSquared = dot(diffPixels, diffPixels);

          if(distanceSquared >= diameter * diameter)
          {
            otherIndex = nextParticles[otherIndex];
            continue;
          }

          float dist = sqrt(distanceSquared);
          vec2 normal;

          if(dist > 0.00001f) normal = diffPixels / dist;
          else normal = (i < uint(otherIndex)) ? vec2(1.0, 0.0) : vec2(-1.0, 0.0);

          float overlap = diameter - dist;
          positionCorrectionPixels += normal * overlap * 0.5f;

          vec2 relativeVelocityPixels = (baseVelocity - other.velocity) * pixelsPerNdc;
          float normalVelocity = dot(relativeVelocityPixels, normal);

          if(normalVelocity >= 0.0)
          {
            otherIndex = nextParticles[otherIndex];
            continue;
          }

          float impulse = -(1.0 + PARTICLE_BOUNCINESS) * normalVelocity * 0.5f;
          velocityCorrectionPixels += impulse * normal;
          
          otherIndex = nextParticles[otherIndex];
        }

      }
    }
    
    p.position = basePosition + positionCorrectionPixels * ndcPerPixel;
    p.velocity = baseVelocity + velocityCorrectionPixels * ndcPerPixel;
    particlesA[i] = p;
  }
}
